
clc

% Crear los tres ejes
line([0 10],[0 0],[0 0], ...
    'LineWidth',1.5,'Color','red');

line([0 0],[0 10],[0 0], ...
    'LineWidth',1.5,'Color','magenta');

line([0 0],[0 0],[0 10], ...
    'LineWidth',1.5,'Color','green');

% Activar el grid y mantener los dibujos
grid on
hold on

% Elegir el punto de vista
view(45,30)

% Pedir las medidas de la caja
x = input("Enter the desired lenght for x base: [m] ");
y = input("Enter the desired lenght for y lenght: [m] ");
z = input("Enter the desired lenght for z height: [m] ");

% Crear los puntos de la base
joint1 = [0 0 0 1]';
joint2 = [x 0 0 1]';
joint3 = [0 y 0 1]';
joint4 = [x y 0 1]';

% Crear los puntos de la parte superior
joint5 = [0 0 z 1]';
joint6 = [x 0 z 1]';
joint7 = [0 y z 1]';
joint8 = [x y z 1]';

% Dibujar la base de la caja

line([joint1(1) joint2(1)], ...
     [joint1(2) joint2(2)], ...
     [joint1(3) joint2(3)], ...
     'LineWidth',3,'Color','blue');

line([joint1(1) joint3(1)], ...
     [joint1(2) joint3(2)], ...
     [joint1(3) joint3(3)], ...
     'LineWidth',3,'Color','blue');

line([joint2(1) joint4(1)], ...
     [joint2(2) joint4(2)], ...
     [joint2(3) joint4(3)], ...
     'LineWidth',3,'Color','blue');

line([joint3(1) joint4(1)], ...
     [joint3(2) joint4(2)], ...
     [joint3(3) joint4(3)], ...
     'LineWidth',3,'Color','blue');

% Dibujar las lineas verticales

line([joint1(1) joint5(1)], ...
     [joint1(2) joint5(2)], ...
     [joint1(3) joint5(3)], ...
     'LineWidth',3,'Color','blue');

line([joint2(1) joint6(1)], ...
     [joint2(2) joint6(2)], ...
     [joint2(3) joint6(3)], ...
     'LineWidth',3,'Color','blue');

line([joint3(1) joint7(1)], ...
     [joint3(2) joint7(2)], ...
     [joint3(3) joint7(3)], ...
     'LineWidth',3,'Color','blue');

line([joint4(1) joint8(1)], ...
     [joint4(2) joint8(2)], ...
     [joint4(3) joint8(3)], ...
     'LineWidth',3,'Color','blue');

% Dibujar la parte superior

line([joint5(1) joint6(1)], ...
     [joint5(2) joint6(2)], ...
     [joint5(3) joint6(3)], ...
     'LineWidth',3,'Color','blue');

line([joint6(1) joint8(1)], ...
     [joint6(2) joint8(2)], ...
     [joint6(3) joint8(3)], ...
     'LineWidth',3,'Color','blue');

line([joint8(1) joint7(1)], ...
     [joint8(2) joint7(2)], ...
     [joint8(3) joint7(3)], ...
     'LineWidth',3,'Color','blue');

line([joint7(1) joint5(1)], ...
     [joint7(2) joint5(2)], ...
     [joint7(3) joint5(3)], ...
     'LineWidth',3,'Color','blue');

% Mostrar los puntos de la caja

scatter3(joint1(1),joint1(2),joint1(3),'filled','green');
scatter3(joint2(1),joint2(2),joint2(3),'filled','green');
scatter3(joint3(1),joint3(2),joint3(3),'filled','green');
scatter3(joint4(1),joint4(2),joint4(3),'filled','green');

scatter3(joint5(1),joint5(2),joint5(3),'filled','green');
scatter3(joint6(1),joint6(2),joint6(3),'filled','green');
scatter3(joint7(1),joint7(2),joint7(3),'filled','green');
scatter3(joint8(1),joint8(2),joint8(3),'filled','green');
